<Window x:Class="BlockTheSpot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockTheSpot" Width="900" Height="860" MinWidth="720" MinHeight="650"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#173D2A" CornerRadius="14" Width="58" Height="58" Margin="0,0,16,0">
                <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#88E3AA" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="BlockTheSpot" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="A cleaner desktop listening experience." Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="{Binding VersionLabel}" Command="{Binding ReleasesCommand}" ToolTip="Open releases on GitHub" VerticalAlignment="Center" Padding="12,6"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR SPOTIFY" FontSize="11" FontWeight="SemiBold" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding InstalledLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,3"/>
                            <TextBlock Text="{Binding InstalledDetail}" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock Text="Windows x64" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Install &amp; update" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Command="{Binding RefreshCommand}" Content="Refresh" ToolTip="Refresh versions (Ctrl+R)" Padding="14,7"/>
                        </Grid>
                        <TextBlock Text="Choose a Spotify version" Margin="0,0,0,8"/>
                        <ComboBox x:Name="VersionPicker" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                  IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch" MinHeight="64"
                                  AutomationProperties.Name="Spotify version" MaxDropDownHeight="350">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Badge}" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CatalogHint}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,9,0,18"/>
                        <CheckBox Content="Install selected Spotify version before patching" IsChecked="{Binding ReinstallSpotify}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,5"/>
                        <TextBlock Text="Leave off to keep your current version. A missing Spotify installation is installed automatically."
                                   Style="{StaticResource SecondaryText}" FontSize="12" Margin="28,0,0,16"/>
                        <CheckBox Content="Open Spotify when finished" IsChecked="{Binding LaunchSpotify}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8"/>
                        <Expander Header="Advanced options" Margin="0,8,0,0">
                            <StackPanel Margin="4,12,4,0">
                                <CheckBox Content="Show newer, untested Spotify versions" IsChecked="{Binding AllowUntested}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,5"/>
                                <TextBlock Text="Compatibility is verified only with 1.2.93.667.g7b5cc0ce. Newer versions may not work with BlockTheSpot."
                                           Style="{StaticResource SecondaryText}" FontSize="12" Margin="28,0,0,14"/>
                                <CheckBox Content="Replace Microsoft Store edition" IsChecked="{Binding RemoveStoreEdition}" IsEnabled="{Binding CanEdit}"/>
                                <TextBlock Text="Removes the Store app from this Windows account and installs desktop Spotify. Your account and playlists stay with Spotify."
                                           Style="{StaticResource SecondaryText}" FontSize="12" Margin="28,5,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Expander Header="Activity log" IsExpanded="{Binding ShowLog}" Margin="0,0,0,12">
                    <StackPanel Margin="0,10,0,0">
                        <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 MinHeight="100" MaxHeight="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                 AutomationProperties.Name="Activity log"/>
                        <Button Content="Save log…" Command="{Binding SaveLogCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,10,0" AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding Status}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SecondaryText}" Margin="0,6,0,12"/>
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsLoading}" Height="5" AutomationProperties.Name="Installation progress"/>
                    </StackPanel>
                </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Button Content="Restore original Spotify" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Padding="16,11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Padding="18,11" Margin="0,0,10,0"/>
                    <Button x:Name="InstallButton" Content="Install BlockTheSpot" Command="{Binding InstallCommand}" Padding="24,11" FontWeight="SemiBold"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            AutomationProperties.Name="Install BlockTheSpot"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="Support the music you love. Consider Spotify Premium." FontSize="11" Style="{StaticResource SecondaryText}"/>
                <TextBlock HorizontalAlignment="Right" FontSize="11"><Hyperlink NavigateUri="https://github.com/RobyRew/BlockTheSpot-Installer" RequestNavigate="OpenLink">Source &amp; help</Hyperlink></TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
