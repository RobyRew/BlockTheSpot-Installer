---
import { orderedSources, sourceNote, formatSize, platformNames } from '../lib/catalog.mjs';
const { entry } = Astro.props;
const [source, ...others] = orderedSources(entry);
---
<tr>
  <td><strong>{entry.version}</strong>{entry.tested && <span class="badge tested">Tested for BTS</span>}<small class="hash">{entry.fullVersion.split('.').at(-1)}</small></td>
  <td><span class="platform-label">{platformNames[entry.platform]}</span><small>{entry.architecture} · {entry.format.toUpperCase()}</small></td>
  <td><time datetime={entry.date ?? undefined}>{entry.date ?? 'Not listed'}</time><small>{formatSize(entry.size)}</small></td>
  <td><span class:list={['source-label', source.kind]}>{source.label}</span><small>{sourceNote(source)}</small></td>
  <td class="row-action"><a class="download-link" href={source.url} title={entry.sha256 ? `SHA-256 ${entry.sha256}` : undefined} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${source.label}`}>Download <span aria-hidden="true">↗</span></a>{others.length > 0 && <small class="alt-links">also: {others.map(other => <a href={other.url} title={sourceNote(other)} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${other.label}`}>{other.label}</a>)}</small>}</td>
</tr>
