---
import { selectSource, formatSize, platformNames } from '../lib/catalog.mjs';
const { entry } = Astro.props;
const source = selectSource(entry);
---
<tr>
  <td><strong>{entry.version}</strong>{entry.tested && <span class="badge tested">Tested for BTS</span>}<small class="hash">{entry.fullVersion.split('.').at(-1)}</small></td>
  <td><span class="platform-label">{platformNames[entry.platform]}</span><small>{entry.architecture} · {entry.format.toUpperCase()}</small></td>
  <td><time datetime={entry.date ?? undefined}>{entry.date ?? 'Not listed'}</time><small>{formatSize(entry.size)}</small></td>
  <td><span class:list={['source-label', source.kind]}>{source.label}</span><small>{source.kind === 'archive' ? 'Copied from Spotify by CI · hash listed' : source.kind === 'mirror' ? 'Community hosted' : source.label === 'Spotify CDN' ? 'Archived link · may expire' : 'Direct download'}</small></td>
  <td class="row-action"><a class="download-link" href={source.url} title={entry.sha256 ? `SHA-256 ${entry.sha256}` : undefined} aria-label={`Download Spotify ${entry.fullVersion} for ${platformNames[entry.platform]} ${entry.architecture} from ${source.label}`}>Download <span aria-hidden="true">↗</span></a></td>
</tr>
